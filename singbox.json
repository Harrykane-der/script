{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "disabled": true,
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns_hosts",
        "type": "hosts",
        "predefined": {
          "mtalk.google.com": ["34.92.115.250", "2404:6800:4008:c07::bc"],
          "alt1-mtalk.google.com": ["2607:f8b0:4023:1c05::bc", "74.125.200.188"],
          "alt2-mtalk.google.com": ["192.178.220.188"],
          "alt3-mtalk.google.com": ["2607:f8b0:4023:2009::bc", "74.125.131.188"],
          "alt4-mtalk.google.com": ["209.85.144.188"],
          "alt5-mtalk.google.com": ["2607:f8b0:4003:c0a::bc", "74.125.126.188"],
          "alt6-mtalk.google.com": ["142.250.115.188"],
          "alt7-mtalk.google.com": ["2607:f8b0:4024:c0d::bc", "192.178.131.188"],
          "alt8-mtalk.google.com": ["172.253.132.188"],
          "dl.google.com": ["180.163.151.161"],
          "dl.l.google.com": ["180.163.150.33"]
        }
      },
      {
        "tag": "dns_domain_resolver",
        "type": "local"
      },
      {
        "tag": "dns_direct",
        "type": "udp",
        "server": "223.5.5.5",
        "server_port": 53
      },
      {
        "tag": "dns_proxy",
        "type": "https",
        "server": "pz.fyi",
        "server_port": 443,
        "domain_resolver": "dns_domain_resolver"
      },
      {
        "type": "fakeip",
        "tag": "dns_fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "2001:2::1/48"
      }
    ],
    "rules": [
      { "preferred_by": "dns_hosts", "action": "route", "server": "dns_hosts" },
      { "clash_mode": "Global", "action": "route", "server": "dns_proxy" },
      { "clash_mode": "Direct", "action": "route", "server": "dns_direct" },
      { "query_type": ["A", "AAAA"], "invert": true, "action": "reject", "rcode": "NOERROR" },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          { "package_name": ["jp.konami.pesam", "com.mojang.minecraft"] },
          { "rule_set": ["game_domain"] }
        ],
        "action": "route",
        "server": "dns_direct",
        "client_subnet": "39.144.162.180"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          { "rule_set": ["ablock_domain", "adblock_domain"] },
          { "rule_set": ["whitelist_domain"], "invert": true }
        ],
        "action": "predefined",
        "answer": ["*. 1 IN A 192.0.2.1", "*. 1 IN AAAA fc00::"],
        "rcode": "NOERROR"
      },
      { "rule_set": ["proxy_emby_domain"], "action": "route", "server": "dns_proxy", "client_subnet": "39.144.162.180" },
      { "rule_set": ["direct_emby_domain", "fakeip-filter_domain"], "action": "route", "server": "dns_direct", "client_subnet": "39.144.162.180" },
      { "rule_set": ["bilibili_domain", "bytedance_domain"], "action": "route", "server": "dns_fakeip", "rewrite_ttl": 1 },
      { "action": "evaluate", "server": "dns_proxy", "client_subnet": "39.144.162.180" },
      { "rule_set": ["bilibili_ip", "bytedance_ip", "cn_ip"], "action": "route", "server": "dns_direct", "match_response": true, "client_subnet": "39.144.162.180" },
      { "rule_set": ["google_fcm_ip", "google_ip", "media_ip", "telegram_ip", "twitter_ip"], "action": "route", "server": "dns_proxy", "match_response": true, "client_subnet": "39.144.162.180" },
      { "query_type": ["A", "AAAA"], "action": "route", "server": "dns_fakeip", "rewrite_ttl": 1 }
    ],
    "optimistic": { "enabled": true, "timeout": "3d" },
    "cache_capacity": 16192,
    "strategy": "prefer_ipv4",
    "final": "dns_proxy",
    "timeout": "5s"
  },
  "inbounds": [
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "::",
      "listen_port": 9999
    },
    {
      "tag": "tun-in",
      "type": "tun",
      "interface_name": "singbox",
      "address": ["172.18.0.1/30", "fdfe:dcba:9876::1/126"],
      "auto_route":true,
      "strict_route": true,
      "stack": "mixed",
      "mtu": 9000,
      "dns_mode": "hijack",
      "dns_address": ["172.18.0.2", "fdfe:dcba:9876::2"],
      "endpoint_independent_nat": true,
      "udp_timeout": "5m",
      "udp_mapping": "address_dependent",
      "udp_filtering": "endpoint_independent"
    }
  ],
