{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "disabled": true,
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns_hosts",
        "type": "hosts",
        "predefined": {
          "mtalk.google.com": ["34.92.115.250", "2404:6800:4008:c07::bc"],
          "alt1-mtalk.google.com": ["2607:f8b0:4023:1c05::bc", "74.125.200.188"],
          "alt2-mtalk.google.com": ["192.178.220.188"],
          "alt3-mtalk.google.com": ["2607:f8b0:4023:2009::bc", "74.125.131.188"],
          "alt4-mtalk.google.com": ["209.85.144.188"],
          "alt5-mtalk.google.com": ["2607:f8b0:4003:c0a::bc", "74.125.126.188"],
          "alt6-mtalk.google.com": ["142.250.115.188"],
          "alt7-mtalk.google.com": ["2607:f8b0:4024:c0d::bc", "192.178.131.188"],
          "alt8-mtalk.google.com": ["172.253.132.188"],
          "dl.google.com": ["180.163.151.161"],
          "dl.l.google.com": ["180.163.150.33"]
        }
      },
      {
        "tag": "dns_domain_resolver",
        "type": "local"
      },
      {
        "tag": "dns_direct",
        "type": "udp",
        "server": "223.5.5.5",
        "server_port": 53,
        "detour": "🇨🇳 Direct"
      },
      {
        "tag": "dns_proxy",
        "type": "tls",
        "server": "dns.google",
        "server_port": 853,
        "domain_resolver": "dns_domain_resolver",
        "detour": "🧬 proxy_dns"
      },
      { "tag": "dns_fakeip", "type": "fakeip", "inet4_range": "11.0.0.0/8", "inet6_range": "2001:2::/48" }
    ],
    "rules": [
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "query_type": "AAAA"
          },
          {
            "default_interface_address": "2000::/3",
            "invert": true
          }
        ],
        "action": "reject",
        "method": "default",
        "no_drop": true
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "ip_version": 6
          },
          {
            "default_interface_address": [
              "2000::/3"
            ],
            "invert": true
          }
        ],
        "action": "reject",
        "method": "default",
        "no_drop": true
      },    
      { "query_type": ["A", "AAAA"], "invert": true, "action": "reject", "rcode": "NOERROR" },
      { "preferred_by": "dns_hosts", "action": "route", "server": "dns_hosts" },
      { "clash_mode": "Global", "action": "route", "server": "dns_proxy" },
      { "clash_mode": "Direct", "action": "route", "server": "dns_direct" },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          { "package_name": ["jp.konami.pesam", "com.mojang.minecraft"] },
          { "rule_set": ["game_domain"] }
        ],
        "action": "route",
        "server": "dns_direct",
        "client_subnet": "39.144.162.180"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          { "rule_set": ["ablock_domain", "adblock_domain"] },
          { "rule_set": ["whitelist_domain"], "invert": true }
        ],
        "action": "predefined",
        "answer": ["*. 1 IN A 192.0.2.1", "*. 1 IN AAAA fc00::1"],
        "rcode": "NOERROR"
      },
      { "rule_set": ["direct_emby_domain"], "action": "route", "server": "dns_direct" },
      { "rule_set": ["proxy_emby_domain"], "action": "route", "server": "dns_proxy" },          
      { "action": "evaluate", "server": "dns_proxy", "tag": "dns_evaluate_proxy", "speculative": true, "client_subnet": "39.144.162.180" },
      { "action": "evaluate", "server": "dns_direct", "tag": "dns_evaluate_direct", "speculative": true, "client_subnet": "39.144.162.180" },
      { "rule_set": ["bilibili_ip", "bytedance_ip", "google_fcm_ip", "google_ip", "media_ip", "telegram_ip", "twitter_ip"], "action": "route", "server": "dns_proxy", "match_response": "dns_evaluate_proxy", "race": true },
      { "rule_set": ["cn_ip"], "action": "route", "server": "dns_direct", "match_response": "dns_evaluate_proxy", "race": true },
      { "rule_set": ["bilibili_ip", "bytedance_ip", "google_fcm_ip", "google_ip", "media_ip", "telegram_ip", "twitter_ip"], "action": "route", "server": "dns_proxy", "match_response": "dns_evaluate_direct", "race": true },
      { "rule_set": ["cn_ip"], "action": "route", "server": "dns_direct", "match_response": "dns_evaluate_direct", "race": true },
      { "query_type": ["A", "AAAA"], "action": "route", "server": "dns_fakeip", "rewrite_ttl": 1 }
    ],
    "optimistic": { "enabled": true, "timeout": "3d" },
    "cache_capacity": 16192,
    "strategy": "ipv4_only",
    "final": "dns_proxy",
    "timeout": "5s"
  },
  "inbounds": [
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "::",
      "listen_port": 9999
    },
    {
      "tag": "tun-in",
      "type": "tun",
      "interface_name": "singbox",
      "address": ["172.18.0.1/30", "fdfe:dcba:9876::1/126"],
      "auto_route":true,
      "strict_route": true,
      "stack": "mixed",
      "mtu": 9000,
      "dns_mode": "hijack",
      "dns_address": ["172.18.0.2", "fdfe:dcba:9876::2"],
      "endpoint_independent_nat": true,
      "udp_timeout": "5m",
      "udp_mapping": "address_and_port_dependent",
      "udp_filtering": "endpoint_independent",
      "udp_nat_max": 16384
    }
  ],
  "outbounds": [
    { "type": "selector", "tag": "🚀 Final", "default": "🇭🇰 HKG", "interrupt_exist_connections": true, "outbounds": ["🇭🇰 HKG", "🇯🇵 JPN", "🇸🇬 SGP", "🇺🇸 USA", "🇩🇪 DEU", "🌏 OTN", "🎮 Games", "🇨🇳 Direct"] },
    { "type": "selector", "tag": "🎮 Game", "default": "🎮 Games", "interrupt_exist_connections": true, "outbounds": ["🎮 Games", "🚀 Final", "🇭🇰 HKG", "🇯🇵 JPN", "🇸🇬 SGP", "🇺🇸 USA", "🇩🇪 DEU", "🌏 OTN", "🇨🇳 Direct"] },
    { "type": "selector", "tag": "📺 BiliBili", "default": "🇭🇰 HKG", "interrupt_exist_connections": true, "outbounds": ["🚀 Final", "🇭🇰 HKG", "🇯🇵 JPN", "🇸🇬 SGP", "🇺🇸 USA", "🇩🇪 DEU", "🌏 OTN", "🎮 Games", "🇨🇳 Direct"] },
    { "type": "selector", "tag": "🤖 AI", "default": "🇯🇵 JPN", "interrupt_exist_connections": true, "outbounds": ["🚀 Final", "🇭🇰 HKG", "🇯🇵 JPN", "🇸🇬 SGP", "🇺🇸 USA", "🇩🇪 DEU", "🌏 OTN", "🎮 Games", "🇨🇳 Direct"] },
    { "type": "selector", "tag": "🌐 Google", "default": "🇭🇰 HKG", "interrupt_exist_connections": true, "outbounds": ["🚀 Final", "🇭🇰 HKG", "🇯🇵 JPN", "🇸🇬 SGP", "🇺🇸 USA", "🇩🇪 DEU", "🌏 OTN", "🎮 Games", "🇨🇳 Direct"] },
    { "type": "selector", "tag": "📽️ Media", "default": "🇯🇵 JPN", "interrupt_exist_connections": true, "outbounds": ["🚀 Final", "🇭🇰 HKG", "🇯🇵 JPN", "🇸🇬 SGP", "🇺🇸 USA", "🇩🇪 DEU", "🌏 OTN", "🎮 Games", "🇨🇳 Direct"] },
    { "type": "selector", "tag": "🎬 Emby", "default": "🇭🇰 HKG", "interrupt_exist_connections": true, "outbounds": ["🚀 Final", "🇭🇰 HKG", "🇯🇵 JPN", "🇸🇬 SGP", "🇺🇸 USA", "🇩🇪 DEU", "🌏 OTN", "🎮 Games", "🇨🇳 Direct"] },
    { "type": "selector", "tag": "🐦 Twitter", "default": "🇩🇪 DEU", "interrupt_exist_connections": true, "outbounds": ["🚀 Final", "🇭🇰 HKG", "🇯🇵 JPN", "🇸🇬 SGP", "🇺🇸 USA", "🇩🇪 DEU", "🌏 OTN", "🎮 Games", "🇨🇳 Direct"] },
    { "type": "selector", "tag": "✈️ Telegram", "default": "🇸🇬 SGP", "interrupt_exist_connections": true, "outbounds": ["🚀 Final", "🇭🇰 HKG", "🇯🇵 JPN", "🇸🇬 SGP", "🇺🇸 USA", "🇩🇪 DEU", "🌏 OTN", "🎮 Games", "🇨🇳 Direct"] },
    { "type": "selector", "tag": "♫ TikTok", "default": "🇩🇪 DEU", "interrupt_exist_connections": true, "outbounds": ["🚀 Final", "🇭🇰 HKG", "🇯🇵 JPN", "🇸🇬 SGP", "🇺🇸 USA", "🇩🇪 DEU", "🌏 OTN", "🎮 Games", "🇨🇳 Direct"] },
    { "type": "selector", "tag": "🔞 Pixiv", "default": "🇯🇵 JPN", "interrupt_exist_connections": true, "outbounds": ["🚀 Final", "🇭🇰 HKG", "🇯🇵 JPN", "🇸🇬 SGP", "🇺🇸 USA", "🇩🇪 DEU", "🌏 OTN", "🎮 Games", "🇨🇳 Direct"] },
    { "type": "selector", "tag": "📦 Github", "default": "🇭🇰 HKG", "interrupt_exist_connections": true, "outbounds": ["🚀 Final", "🇭🇰 HKG", "🇯🇵 JPN", "🇸🇬 SGP", "🇺🇸 USA", "🇩🇪 DEU", "🌏 OTN", "🎮 Games", "🇨🇳 Direct"] },
    { "type": "selector", "tag": "📥 FCM", "default": "🇨🇳 Direct", "interrupt_exist_connections": true, "outbounds": ["🚀 Final", "🇭🇰 HKG", "🇯🇵 JPN", "🇸🇬 SGP", "🇺🇸 USA", "🇩🇪 DEU", "🌏 OTN", "🎮 Games", "🇨🇳 Direct"] },
    { "type": "urltest", "tag": "🎮 Games", "url": "https://cp.cloudflare.com/generate_204", "interval": "3m", "tolerance": 50000, "outbounds": ["🎮 Games_Node", "🎮 Games_Pick", "🎮 Games_Auto"] },
    { "type": "urltest", "tag": "🇭🇰 HKG", "url": "https://cp.cloudflare.com/generate_204", "interval": "3m", "tolerance": 50000, "outbounds": ["🇭🇰 HKG_Node", "🇭🇰 HKG_Pick", "🇭🇰 HKG_Auto"] },
    { "type": "urltest", "tag": "🇯🇵 JPN", "url": "https://cp.cloudflare.com/generate_204", "interval": "3m", "tolerance": 50000, "outbounds": ["🇯🇵 JPN_Node", "🇯🇵 JPN_Pick", "🇯🇵 JPN_Auto"] },
    { "type": "urltest", "tag": "🇸🇬 SGP", "url": "https://cp.cloudflare.com/generate_204", "interval": "3m", "tolerance": 50000, "outbounds": ["🇸🇬 SGP_Pick", "🇸🇬 SGP_Auto"] },
    { "type": "urltest", "tag": "🇺🇸 USA", "url": "https://cp.cloudflare.com/generate_204", "interval": "3m", "tolerance": 50000, "outbounds": ["🇺🇸 USA_Pick", "🇺🇸 USA_Auto"] },
    { "type": "urltest", "tag": "🇩🇪 DEU", "url": "https://cp.cloudflare.com/generate_204", "interval": "3m", "tolerance": 50000, "outbounds": ["🇩🇪 DEU_Node", "🇩🇪 DEU_Pick", "🇩🇪 DEU_Auto"] },
    { "type": "urltest", "tag": "🌏 OTN", "url": "https://cp.cloudflare.com/generate_204", "interval": "3m", "tolerance": 50000, "outbounds": ["🌏 OTN_Pick", "🌏 OTN_Auto"] },
    { "type": "selector", "tag": "🎮 Games_Node", "outbounds": [] },
    { "type": "selector", "tag": "🎮 Games_Pick", "outbounds": [] },
    { "type": "selector", "tag": "🇭🇰 HKG_Node", "outbounds": [] },    
    { "type": "selector", "tag": "🇭🇰 HKG_Pick", "outbounds": [] },
    { "type": "selector", "tag": "🇯🇵 JPN_Node", "outbounds": [] },
    { "type": "selector", "tag": "🇯🇵 JPN_Pick", "outbounds": [] },
    { "type": "selector", "tag": "🇸🇬 SGP_Pick", "outbounds": [] },
    { "type": "selector", "tag": "🇺🇸 USA_Pick", "outbounds": [] },
    { "type": "selector", "tag": "🇩🇪 DEU_Node", "outbounds": [] },
    { "type": "selector", "tag": "🇩🇪 DEU_Pick", "outbounds": [] },
    { "type": "selector", "tag": "🌏 OTN_Pick", "outbounds": [] },
    { "type": "urltest", "tag": "🎮 Games_Auto", "url": "https://cp.cloudflare.com/generate_204", "interval": "3m", "outbounds": [] },
    { "type": "urltest", "tag": "🇭🇰 HKG_Auto", "url": "https://cp.cloudflare.com/generate_204", "interval": "3m", "outbounds": [] },
    { "type": "urltest", "tag": "🇯🇵 JPN_Auto", "url": "https://cp.cloudflare.com/generate_204", "interval": "3m", "outbounds": [] },
    { "type": "urltest", "tag": "🇸🇬 SGP_Auto", "url": "https://cp.cloudflare.com/generate_204", "interval": "3m", "outbounds": [] },
    { "type": "urltest", "tag": "🇺🇸 USA_Auto", "url": "https://cp.cloudflare.com/generate_204", "interval": "3m", "outbounds": [] },
    { "type": "urltest", "tag": "🇩🇪 DEU_Auto", "url": "https://cp.cloudflare.com/generate_204", "interval": "3m", "outbounds": [] },
    { "type": "urltest", "tag": "🌏 OTN_Auto", "url": "https://cp.cloudflare.com/generate_204", "interval": "3m", "outbounds": [] },   
    { "type": "selector", "tag": "⚓ HKG_Front", "outbounds": ["🇨🇳 Direct"] },
    { "type": "selector", "tag": "⚓ JPN_Front", "outbounds": ["🇨🇳 Direct"] },
    { "type": "selector", "tag": "⚓ DEU_Front", "outbounds": ["🇨🇳 Direct"] },
    { "type": "selector", "tag": "🧬 proxy_dns", "outbounds": ["🇭🇰 HKG", "🇯🇵 JPN"] },
    { "tag": "🇨🇳 Direct", "type": "direct", "domain_resolver": { "server": "dns_direct", "strategy": "prefer_ipv4" } }
  ],
  "services": [
    {
      "type": "api",
      "tag": "sing-box-api",
      "listen": "0.0.0.0",
      "listen_port": 8888,
      "access_control_allow_private_network": true
    }
  ],
  "http_clients": [
    { "tag": "download_remote", "version": 2, "domain_resolver": "dns_direct" }
  ],
  "route": {
    "default_http_client": "download_remote",
    "default_domain_resolver": { "server": "dns_alldns", "strategy": "prefer_ipv4" },
    "rules": [
      { "ip_cidr": ["172.18.0.2", "fdfe:dcba:9876::2"], "action": "hijack-dns" },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "ip_version": 6
          },
          {
            "default_interface_address": [
              "2000::/3"
            ],
            "invert": true
          }
        ],
        "action": "reject",
        "method": "default",
        "no_drop": true
      },
      { "clash_mode": "Global", "action": "route", "outbound": "🚀 Final" },
      { "clash_mode": "Direct", "action": "route", "outbound": "🇨🇳 Direct" },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          { "package_name": ["jp.konami.pesam", "com.mojang.minecraft"] },
          { "rule_set": ["game_domain"] }
        ],
        "action": "route",
        "outbound": "🎮 Game"
      },
      { "protocol": ["stun", "quic", "dtls"], "action": "reject", "method": "default", "no_drop": true },
      { "network": ["icmp"], "action": "reject", "method": "default", "no_drop": true },
      { "network": ["udp"], "port": [53, 80, 443, 853, 784, 8443, 8853], "port_range": ["3478:3479", "5349:5350", "6881:6889", "10000:"], "action": "reject", "method": "default", "no_drop": true },
      { "network": ["tcp"], "port": [53, 853], "port_range": ["3478:3479", "5349:5350", "10000:"], "action": "reject", "method": "default", "no_drop": true },
      { "ip_cidr": ["192.0.2.1", "fc00::1"], "action": "reject", "method": "default", "no_drop": true },
      { "ip_is_private": true, "outbound": "🇨🇳 Direct" },
      { "rule_set": ["telegram_domain", "telegram_ip"], "invert": true, "action": "sniff" },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          { "rule_set": ["ablock_domain", "adblock_domain"] },
          { "rule_set": ["whitelist_domain"], "invert": true }
        ],
        "action": "reject",
        "method": "default",
        "no_drop": true
      },
      { "rule_set": ["google_fcm_domain", "google_fcm_ip"], "action": "route", "outbound": "📥 FCM" },
      { "rule_set": ["telegram_domain", "telegram_ip"], "action": "route", "outbound": "✈️ Telegram" },
      { "rule_set": ["ai_domain"], "action": "route", "outbound": "🤖 AI" },
      { "rule_set": ["bytedance_domain", "bytedance_ip"], "action": "route", "outbound": "♫ TikTok" },
      { "rule_set": ["bilibili_domain", "bilibili_ip"], "action": "route", "outbound": "📺 BiliBili" },
      { "rule_set": ["github_domain"], "action": "route", "outbound": "📦 Github" },
      { "rule_set": ["pixiv_domain"], "action": "route", "outbound": "🔞 Pixiv" },
      { "rule_set": ["twitter_domain", "twitter_ip"], "action": "route", "outbound": "🐦 Twitter" },
      { "rule_set": ["proxy_emby_domain"], "action": "route", "outbound": "🎬 Emby" },
      { "rule_set": ["media_domain", "media_ip"], "action": "route", "outbound": "📽️ Media" },
      { "rule_set": ["google_domain", "google_ip", "google_cn_domain"], "action": "route", "outbound": "🌐 Google" },
      { "rule_set": ["cn_ip", "direct_emby_domain"], "action": "route", "outbound": "🇨🇳 Direct" }
    ],
    "rule_set": [
      { "type": "remote", "tag": ["ablock_domain", "adblock_domain", "ai_domain", "bilibili_domain", "bytedance_domain", "direct_emby_domain", "game_domain", "github_domain", "google_cn_domain", "google_domain", "google_fcm_domain", "media_domain", "pixiv_domain", "proxy_emby_domain", "telegram_domain", "twitter_domain", "whitelist_domain"], "format": "binary", "url": "https://gh-proxy.com/https://github.com/Harrykane-der/ruleset-for-singbox-and-mihomo/raw/refs/heads/rule_set/{tag}.srs", "update_interval": "1h" },
      { "type": "remote", "tag": ["bilibili_ip", "bytedance_ip", "cn_ip", "google_fcm_ip", "google_ip", "media_ip", "telegram_ip", "twitter_ip"], "format": "binary", "url": "https://gh-proxy.com/https://github.com/Harrykane-der/ruleset-for-singbox-and-mihomo/raw/refs/heads/rule_set/{tag}.srs", "update_interval": "1h" }
    ],
    "auto_detect_interface": true,
    "final": "🚀 Final"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_fakeip": true,
      "store_dns": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "ui",
      "external_ui_download_url": "https://github.com/Zephyruso/zashboard/releases/download/v3.22.0/dist-no-fonts.zip",
      "default_mode": "Rule"
    }
  }
}
