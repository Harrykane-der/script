    { "type": "urltest", "tag": "🇪🇺 EU_Auto", "outbounds": [], "url": "https://www.apple.com/library/test/success.html", "interval": "6m" },
    { "type": "selector", "tag": "🔗 proxy_dns", "outbounds": ["🇭🇰 HK", "🇯🇵 JP"] },
    { "tag": "🇨🇳 Direct", "type": "direct" }
