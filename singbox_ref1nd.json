          "dl.l.google.com": ["180.163.150.33"]
        }
      },
      {
        "tag": "dns_local",
        "type": "local"
      },
      {
        "tag": "dns_alidns",
        "type": "udp",
        "server": "223.5.5.5",
        "server_port": 53
      },
      {
        "tag": "dns_dnspod",
        "type": "udp",
        "server": "129.29.29.29",
        "server_port": 53
      },
      {
        "tag": "dns_114dns",
        "type": "udp",
        "server": "114.114.114.114",
        "server_port": 53
      },
      {
        "tag": "dns_pz",
        "type": "https",
        "server": "pz.fyi",
        "server_port": 443,
        "domain_resolver": "dns_domain_resolver"
      },
      {
        "tag": "dns_opendns",
        "type": "udp",
        "server": "208.67.220.220",
        "server_port": 443
      },
      {
        "tag": "dns_nextdns",
        "type": "udp",
        "server": "45.90.28.0",
        "server_port": 5353
      },
      {
        "tag": "dns_quad9",
        "type": "udp",
        "server": "149.112.112.112",
        "server_port": 9953
      },
      {
        "tag": "dns_google",
        "type": "https",
        "server": "dns.google",
        "server_port": 443,
        "domain_resolver": "dns_domain_resolver",
        "detour": "🔗 proxy_dns"
      },
      {
        "tag": "dns_adguard",
        "type": "https",
        "server": "unfiltered.adguard-dns.com",
        "server_port": 443,
        "domain_resolver": "dns_domain_resolver",
        "detour": "🔗 proxy_dns"
      },
      { "tag": "dns_domain_resolver", "type": "group", "servers": ["dns_local", "dns_alidns", "dns_dnspod", "dns_114dns", "dns_opendns", "dns_nextdns", "dns_quad9"] },
      { "tag": "dns_alldns", "type": "group", "servers": ["dns_local", "dns_alidns", "dns_dnspod", "dns_114dns", "dns_opendns", "dns_nextdns", "dns_quad9", "dns_pz", "dns_google", "dns_adguard"] },      
      { "tag": "dns_direct", "type": "group", "servers": ["dns_local", "dns_pz", "dns_alidns", "dns_dnspod"] },
      { "tag": "dns_proxy", "type": "group", "servers": ["dns_opendns", "dns_nextdns", "dns_quad9", "dns_pz", "dns_google", "dns_adguard"] },
      { "tag": "dns_fakeip", "type": "fakeip", "inet4_range": "198.18.0.0/15", "inet6_range": "2001:2::1/48" }
    ],
    "rules": [
      { "preferred_by": "dns_hosts", "action": "route", "server": "dns_hosts" },
      { "clash_mode": "Global", "action": "route", "server": "dns_proxy" },
      { "clash_mode": "Direct", "action": "route", "server": "dns_direct" },
      { "query_type": ["A", "AAAA"], "invert": true, "action": "reject", "rcode": "NOERROR" },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          { "package_name": ["jp.konami.pesam", "com.mojang.minecraft"] },
          { "rule_set": ["game_domain"] }
        ],
        "action": "route",
        "server": "dns_alldns"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          { "rule_set": ["ablock_domain", "adblock_domain"] },
          { "rule_set": ["whitelist_domain"], "invert": true }
        ],
        "action": "predefined",
        "answer": ["*. 1 IN A 192.0.2.1", "*. 1 IN AAAA fc00::"],
        "rcode": "NOERROR"
      },
      { "rule_set": ["proxy_emby_domain"], "action": "route", "server": "dns_proxy" },
      { "rule_set": ["direct_emby_domain", "fakeip-filter_domain"], "action": "route", "server": "dns_alldns" },
      { "rule_set": ["bilibili_domain", "bytedance_domain"], "action": "route", "server": "dns_fakeip", "rewrite_ttl": 1 },
      { "action": "evaluate", "server": "dns_alldns", "client_subnet": "39.144.162.180" },
      { "rule_set": ["bilibili_ip", "bytedance_ip", "cn_ip"], "action": "route", "server": "dns_direct", "match_response": true, "client_subnet": "39.144.162.180" },
      { "rule_set": ["google_fcm_ip", "google_ip", "media_ip", "telegram_ip", "twitter_ip"], "action": "route", "server": "dns_proxy", "match_response": true, "client_subnet": "39.144.162.180" },
      { "query_type": ["A", "AAAA"], "action": "route", "server": "dns_fakeip", "rewrite_ttl": 1 }
    ],
    "optimistic": { "enabled": true, "timeout": "3d" },
    "cache_capacity": 16192,
    "strategy": "prefer_ipv4",
    "final": "dns_proxy",
    "timeout": "5s"
  },
  "inbounds": [
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "::",
      "listen_port": 9999
    },
    {
      "tag": "tun-in",
