      "address": ["172.18.0.1/30", "fdfe:dcba:9876::1/126"],
      "auto_route":true,
      "strict_route": true,
      "stack": "mixed",
      "mtu": 9000,
      "dns_mode": "hijack",
      "dns_address": ["172.18.0.2", "fdfe:dcba:9876::2"],
      "endpoint_independent_nat": true,
      "udp_timeout": "5m",
      "udp_mapping": "address_dependent",
      "udp_filtering": "endpoint_independent"
    }
  ],
  "outbounds": [
