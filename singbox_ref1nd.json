          { "query_type": "AAAA" },
          { "default_interface_address": "2000::/3", "invert": true }
        ],
        "action": "reject",
        "method": "default",
        "no_drop": true
      },
      { "protocol": ["stun", "quic", "dtls"], "action": "reject", "method": "default", "no_drop": true },
      { "network": ["udp"], "port": [443], "action": "reject", "method": "default", "no_drop": true },
      { "query_type": ["SVCB", "HTTPS", "PTR"], "action": "reject", "rcode": "NOERROR" },
      { "preferred_by": "dns_hosts", "action": "route", "server": "dns_hosts" },
      { "clash_mode": "Global", "action": "route", "server": "dns_proxy" },
      { "clash_mode": "Direct", "action": "route", "server": "dns_direct" },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          { "package_name": ["jp.konami.pesam", "com.mojang.minecraft"] },
          { "rule_set": ["direct_emby_domain", "fakeip-filter_domain", "game_domain", "google_fcm_domain", "proxy_emby_domain"] }
        ],
        "action": "evaluate",
        "server": "dns_direct",
        "tag": "dns_evaluate_front_direct",
        "client_subnet": "39.144.162.180"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          { "package_name": ["jp.konami.pesam", "com.mojang.minecraft"] },
          { "rule_set": ["direct_emby_domain", "fakeip-filter_domain", "game_domain", "google_fcm_domain", "proxy_emby_domain"] }
        ],
        "action": "evaluate",
        "server": "dns_proxy",
        "tag": "dns_evaluate_front_proxy",
        "client_subnet": "39.144.162.180"
      },
      { "action": "respond", "match_response": "dns_evaluate_front_direct", "race": true },
      { "action": "respond", "match_response": "dns_evaluate_front_proxy", "race": true },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          { "clash_mode": "Allow", "invert": true },
          { "rule_set": ["whitelist_domain"], "invert": true },
          { "rule_set": ["ablock_domain", "adblock_domain"] }
        ],
        "action": "reject",
        "method": "default",
        "rcode": "NXDOMAIN",
        "no_drop": true
      },
      { "rule_set": ["ai_domain", "bilibili_domain", "github_domain", "google_cn_domain", "google_domain", "google_fcm_domain", "media_domain", "pixiv_domain", "tiktok_domain", "twitter_domain"], "query_type": ["A", "AAAA"], "action": "route", "server": "dns_fakeip", "rewrite_ttl": 1 },
      { "action": "evaluate", "server": "dns_direct", "tag": "dns_evaluate_rear_direct", "client_subnet": "39.144.162.180" },
      { "action": "evaluate", "server": "dns_proxy", "tag": "dns_evaluate_rear_proxy", "client_subnet": "39.144.162.180" },
      { "rule_set": ["cn_ip"], "action": "respond", "match_response": "dns_evaluate_rear_direct", "race": true },
      { "rule_set": ["cn_ip"], "action": "respond", "match_response": "dns_evaluate_rear_proxy", "race": true },
      { "action": "route", "server": "dns_proxy", "client_subnet": "39.144.162.180" }
    ],
    "optimistic": { "enabled": true, "timeout": "1d" },
    "cache_capacity": 16192,
    "final": "dns_proxy",
    "timeout": "5s"
  },
