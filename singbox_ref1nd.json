    { "type": "selector", "tag": "📺 BiliBili", "default": "🇭🇰 HK", "interrupt_exist_connections": true, "outbounds": ["♻️ Final", "🇭🇰 HK", "🇯🇵 JP", "🇸🇬 SG", "🇺🇸 US", "🇪🇺 EU", "🎮 Games", "🇨🇳 Direct"] },
    { "type": "selector", "tag": "🤖 AI", "default": "🇯🇵 JP", "interrupt_exist_connections": true, "outbounds": ["♻️ Final", "🇭🇰 HK", "🇯🇵 JP", "🇸🇬 SG", "🇺🇸 US", "🇪🇺 EU", "🎮 Games", "🇨🇳 Direct"] },
    { "type": "selector", "tag": "🔍 Google", "default": "🇭🇰 HK", "interrupt_exist_connections": true, "outbounds": ["♻️ Final", "🇭🇰 HK", "🇯🇵 JP", "🇸🇬 SG", "🇺🇸 US", "🇪🇺 EU", "🎮 Games", "🇨🇳 Direct"] },
    { "type": "selector", "tag": "📽️ Media", "default": "🇭🇰 HK", "interrupt_exist_connections": true, "outbounds": ["♻️ Final", "🇭🇰 HK", "🇯🇵 JP", "🇸🇬 SG", "🇺🇸 US", "🇪🇺 EU", "🎮 Games", "🇨🇳 Direct"] },
    { "type": "selector", "tag": "🐦 Twitter", "default": "🇪🇺 EU", "interrupt_exist_connections": true, "outbounds": ["♻️ Final", "🇭🇰 HK", "🇯🇵 JP", "🇸🇬 SG", "🇺🇸 US", "🇪🇺 EU", "🎮 Games", "🇨🇳 Direct"] },
    { "type": "selector", "tag": "✉️ Telegram", "default": "🇸🇬 SG", "interrupt_exist_connections": true, "outbounds": ["♻️ Final", "🇭🇰 HK", "🇯🇵 JP", "🇸🇬 SG", "🇺🇸 US", "🇪🇺 EU", "🎮 Games", "🇨🇳 Direct"] },
    { "type": "selector", "tag": "🎵 TikTok", "default": "🇪🇺 EU", "interrupt_exist_connections": true, "outbounds": ["♻️ Final", "🇭🇰 HK", "🇯🇵 JP", "🇸🇬 SG", "🇺🇸 US", "🇪🇺 EU", "🎮 Games", "🇨🇳 Direct"] },
    { "type": "selector", "tag": "🔞 Pixiv", "default": "🇯🇵 JP", "interrupt_exist_connections": true, "outbounds": ["♻️ Final", "🇭🇰 HK", "🇯🇵 JP", "🇸🇬 SG", "🇺🇸 US", "🇪🇺 EU", "🎮 Games", "🇨🇳 Direct"] },
    { "type": "selector", "tag": "⏳ Github", "default": "🇭🇰 HK", "interrupt_exist_connections": true, "outbounds": ["♻️ Final", "🇭🇰 HK", "🇯🇵 JP", "🇸🇬 SG", "🇺🇸 US", "🇪🇺 EU", "🎮 Games", "🇨🇳 Direct"] },
    { "type": "selector", "tag": "📨 FCM", "default": "🇨🇳 Direct", "interrupt_exist_connections": true, "outbounds": ["♻️ Final", "🇭🇰 HK", "🇯🇵 JP", "🇸🇬 SG", "🇺🇸 US", "🇪🇺 EU", "🎮 Games", "🇨🇳 Direct"] },
    { "type": "urltest", "tag": "🎮 Games", "outbounds": ["🎮 Games_Pick", "🎮 Games_Auto"], "fallback": { "enabled": true, "max_delay": "5000ms" }, "url": "https://www.apple.com/library/test/success.html", "interval": "3m" },
    { "type": "urltest", "tag": "🇭🇰 HK", "outbounds": ["🇭🇰 HK_Pick", "🇭🇰 HK_Auto"], "fallback": { "enabled": true, "max_delay": "5000ms" }, "url": "https://www.apple.com/library/test/success.html", "interval": "3m" },
