    { "type": "urltest", "tag": "🇸🇬 SG", "outbounds": ["🇸🇬 SG_Pick", "🇸🇬 SG_Auto"], "fallback": { "enabled": true, "max_delay": "5000ms" }, "url": "https://www.apple.com/library/test/success.html", "interval": "3m" },
    { "type": "urltest", "tag": "🇺🇸 US", "outbounds": ["🇺🇸 US_Pick", "🇺🇸 US_Auto"], "fallback": { "enabled": true, "max_delay": "5000ms" }, "url": "https://www.apple.com/library/test/success.html", "interval": "3m" },
    { "type": "urltest", "tag": "🇪🇺 EU", "outbounds": ["🇪🇺 EU_Pick", "🇪🇺 EU_Auto"], "fallback": { "enabled": true, "max_delay": "5000ms" }, "url": "https://www.apple.com/library/test/success.html", "interval": "3m" },
    { "type": "selector", "tag": "🎮 Games_Pick", "outbounds": [] },
    { "type": "selector", "tag": "🇭🇰 HK_Pick", "outbounds": [] },
    { "type": "selector", "tag": "🇯🇵 JP_Pick", "outbounds": [] },
    { "type": "selector", "tag": "🇸🇬 SG_Pick", "outbounds": [] },
    { "type": "selector", "tag": "🇺🇸 US_Pick", "outbounds": [] },
    { "type": "selector", "tag": "🇪🇺 EU_Pick", "outbounds": [] },
    { "type": "urltest", "tag": "🎮 Games_Auto", "outbounds": [], "url": "https://www.apple.com/library/test/success.html", "interval": "6m" },
    { "type": "urltest", "tag": "🇭🇰 HK_Auto", "outbounds": [], "url": "https://www.apple.com/library/test/success.html", "interval": "6m" },
